// Prisma schema - Mini-ERP Giapura
// Ver plan: costos -> stock -> ventas (Tienda Nube) -> estado de resultados -> envios

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  OPERADOR
}

enum TipoInsumo {
  INGREDIENTE
  PACKAGING
  OTRO
}

enum TipoItemStock {
  INSUMO
  PRODUCTO_TERMINADO
}

enum TipoMovimientoStock {
  COMPRA
  PRODUCCION_INGRESO
  PRODUCCION_CONSUMO
  VENTA
  AJUSTE
  DEVOLUCION
  TRANSFERENCIA_ZONA // sale del stock de fábrica/depósito hacia "mi zona"
}

enum EstadoLote {
  PLANIFICADO
  EN_FABRICA
  RECIBIDO
}

enum EstadoPedido {
  ABIERTO
  CERRADO
  CANCELADO
}

enum EstadoPago {
  PENDIENTE
  PAGADO
  PARCIAL
  REEMBOLSADO
}

enum EstadoEnvio {
  PENDIENTE
  DESPACHADO
  EN_TRANSITO
  ENTREGADO
  PROBLEMA
}

enum CategoriaGasto {
  COMISION_TIENDANUBE
  COMISION_MERCADOPAGO
  ENVIO
  MARKETING
  FIJO
  OTRO
}

enum TipoComision {
  TIENDANUBE
  MERCADOPAGO
}

enum EstadoPeriodo {
  ABIERTO
  CERRADO
}

// ---------- Usuarios / auditoria ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String
  role         Role     @default(OPERADOR)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())

  auditLogs         AuditLog[]
  comprasCreadas    CompraInsumo[]    @relation("CompraCreatedBy")
  gastosCreados     Gasto[]           @relation("GastoCreatedBy")
  movimientosCreados MovimientoStock[] @relation("MovStockCreatedBy")
  enviosActualizados Envio[]          @relation("EnvioActualizadoPor")
  periodosCerrados  PeriodoContable[] @relation("PeriodoCerradoPor")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  accion    String
  entidad   String
  entidadId String
  detalle   Json?
  createdAt DateTime @default(now())

  @@index([entidad, entidadId])
}

// ---------- Costos ----------

enum NivelSku {
  FRASCO // producto individual, se produce a partir de insumos (receta)
  PACK   // se arma combinando frascos (composición) + packaging propio
}

model Sku {
  id                  String   @id @default(cuid())
  codigo              String   @unique
  nombre              String
  nivel               NivelSku @default(FRASCO)
  tiendaNubeProductId String?
  tiendaNubeVariantId String?
  unidadMedida        String   @default("unidad")
  activo              Boolean  @default(true)
  createdAt           DateTime @default(now())

  // Economía unitaria: precio de venta, merma y prorrateo de gastos fijos
  // para calcular contribución marginal y punto de equilibrio.
  precioVenta               Decimal? @db.Decimal(14, 2)
  perdidaPct                Decimal  @default(0) @db.Decimal(5, 2)
  gastosGeneralesMensuales  Decimal? @db.Decimal(14, 2)
  produccionMensualEstimada Int?

  // Stock mínimo total (fábrica + mi zona) antes de avisar que hay que reponer.
  // Null = sin alerta configurada. Solo tiene sentido para frascos y packs.
  stockMinimo Int?

  recetas          Receta[]
  costosFabrica    CostoFabricaHistorico[]
  lotes            LoteProduccion[]
  movimientosStock MovimientoStock[]
  stockActual      StockActual?
  stockZona        StockZona?
  pedidoItems      PedidoItem[]

  // Composición: si es PACK, de qué frascos se compone (y en cuántos packs se usa cada frasco).
  composicion  SkuComposicion[] @relation("PackComposicion")
  usadoEnPacks SkuComposicion[] @relation("ComponenteDePacks")

  zonaSurPedidoItems ZonaSurPedidoItem[]
}

// Un ítem de la composición de un PACK: qué frasco lleva y cuántos.
model SkuComposicion {
  id           String @id @default(cuid())
  packId       String
  pack         Sku    @relation("PackComposicion", fields: [packId], references: [id], onDelete: Cascade)
  componenteId String
  componente   Sku    @relation("ComponenteDePacks", fields: [componenteId], references: [id])
  cantidad     Int

  @@unique([packId, componenteId])
  @@index([packId])
}

model Insumo {
  id           String     @id @default(cuid())
  nombre       String
  tipo         TipoInsumo
  unidadMedida String
  stockMinimo  Decimal    @default(0) @db.Decimal(12, 3)
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  compras          CompraInsumo[]
  costos           InsumoCosto[]
  recetaItems      RecetaItem[]
  movimientosStock MovimientoStock[]
  stockActual      StockActual?
}

model InsumoCosto {
  id            String    @id @default(cuid())
  insumoId      String
  insumo        Insumo    @relation(fields: [insumoId], references: [id])
  costoUnitario Decimal   @db.Decimal(14, 4)
  vigenteDesde  DateTime
  vigenteHasta  DateTime?
  nota          String?
  createdAt     DateTime  @default(now())

  @@index([insumoId, vigenteDesde])
}

model Receta {
  id           String    @id @default(cuid())
  skuId        String
  sku          Sku       @relation(fields: [skuId], references: [id])
  version      Int
  vigenteDesde DateTime
  vigenteHasta DateTime?
  nota         String?
  createdAt    DateTime  @default(now())

  items RecetaItem[]

  @@unique([skuId, version])
  @@index([skuId, vigenteDesde])
}

model RecetaItem {
  id                String  @id @default(cuid())
  recetaId          String
  receta            Receta  @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  insumoId          String
  insumo            Insumo  @relation(fields: [insumoId], references: [id])
  cantidadPorUnidad Decimal @db.Decimal(12, 4)
  unidadMedida      String
}

model CostoFabricaHistorico {
  id             String    @id @default(cuid())
  skuId          String
  sku            Sku       @relation(fields: [skuId], references: [id])
  costoPorUnidad Decimal   @db.Decimal(14, 4)
  vigenteDesde   DateTime
  vigenteHasta   DateTime?
  nota           String?
  createdAt      DateTime  @default(now())

  @@index([skuId, vigenteDesde])
}

// ---------- Produccion / stock ----------

enum EstadoCompra {
  COMPRADO  // pagada / en camino: cuenta como plata gastada, todavía no es stock disponible
  RECIBIDO  // llegó a la fábrica: suma al stock disponible
  CANCELADO // no se concretó: no cuenta ni como gasto ni como stock
}

// Compra de un insumo en dos pasos: comprado -> recibido en fábrica.
model CompraInsumo {
  id            String       @id @default(cuid())
  insumoId      String
  insumo        Insumo       @relation(fields: [insumoId], references: [id])
  cantidad      Decimal      @db.Decimal(12, 3)
  costoUnitario Decimal      @db.Decimal(14, 4)
  costoTotal    Decimal      @db.Decimal(14, 2)
  fecha         DateTime
  estado        EstadoCompra @default(COMPRADO)
  recibidaAt    DateTime?
  proveedor     String?
  nota          String?
  createdById   String?
  createdBy     User?        @relation("CompraCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime     @default(now())

  movimientos MovimientoStock[]

  @@index([estado])
  @@index([insumoId])
  @@index([fecha])
}

model LoteProduccion {
  id                    String     @id @default(cuid())
  skuId                 String
  sku                   Sku        @relation(fields: [skuId], references: [id])
  fecha                 DateTime
  cantidadUnidades      Decimal    @db.Decimal(12, 3)
  numeroLote            String     @unique
  costoUnitarioSnapshot Decimal?   @db.Decimal(14, 4)
  costoTotalSnapshot    Decimal?   @db.Decimal(14, 2)
  estado                EstadoLote @default(PLANIFICADO)
  nota                  String?
  createdAt             DateTime   @default(now())
  recibidoAt            DateTime?

  movimientos MovimientoStock[]
}

model MovimientoStock {
  id                    String              @id @default(cuid())
  tipoItem              TipoItemStock
  insumoId              String?
  insumo                Insumo?             @relation(fields: [insumoId], references: [id])
  skuId                 String?
  sku                   Sku?                @relation(fields: [skuId], references: [id])
  tipoMovimiento        TipoMovimientoStock
  cantidad              Decimal             @db.Decimal(12, 3)
  costoUnitarioSnapshot Decimal?            @db.Decimal(14, 4)
  loteProduccionId      String?
  loteProduccion        LoteProduccion?     @relation(fields: [loteProduccionId], references: [id])
  compraId              String?
  compra                CompraInsumo?       @relation(fields: [compraId], references: [id])
  pedidoId              String?
  pedido                Pedido?             @relation(fields: [pedidoId], references: [id])
  fecha                 DateTime            @default(now())
  nota                  String?
  createdById           String?
  createdBy             User?               @relation("MovStockCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime            @default(now())

  @@index([insumoId])
  @@index([skuId])
  @@index([tipoMovimiento, fecha])
}

model StockActual {
  id                     String        @id @default(cuid())
  itemTipo               TipoItemStock
  insumoId               String?       @unique
  insumo                 Insumo?       @relation(fields: [insumoId], references: [id])
  skuId                  String?       @unique
  sku                    Sku?          @relation(fields: [skuId], references: [id])
  cantidadActual         Decimal       @default(0) @db.Decimal(12, 3)
  costoPromedioPonderado Decimal?      @db.Decimal(14, 4)
  actualizadoEn          DateTime      @updatedAt
}

// Stock de frascos/packs que el dueño se llevó a su zona para vender aparte del
// depósito nacional (StockActual arriba). Solo existe para SKU, nunca para insumos:
// la materia prima se queda toda en la fábrica.
model StockZona {
  id             String   @id @default(cuid())
  skuId          String   @unique
  sku            Sku      @relation(fields: [skuId], references: [id])
  cantidadActual Int      @default(0)
  actualizadoEn  DateTime @updatedAt
}

// ---------- Ventas / gastos / envios ----------

model Pedido {
  id                       String       @id @default(cuid())
  tiendaNubeOrderId        String?      @unique
  numeroPedido             String
  fecha                    DateTime
  clienteNombre            String?
  clienteEmail             String?
  estadoPedido             EstadoPedido @default(ABIERTO)
  estadoPago               EstadoPago   @default(PENDIENTE)
  estadoEnvio              EstadoEnvio  @default(PENDIENTE)
  subtotal                 Decimal      @db.Decimal(14, 2)
  costoEnvioCobradoCliente Decimal      @default(0) @db.Decimal(14, 2)
  total                    Decimal      @db.Decimal(14, 2)
  rawPayload               Json?
  sincronizadoEn           DateTime?
  createdAt                DateTime     @default(now())

  items            PedidoItem[]
  movimientosStock MovimientoStock[]
  gastos           Gasto[]
  envio            Envio?

  @@index([fecha])
  @@index([estadoPago])
}

model PedidoItem {
  id             String  @id @default(cuid())
  pedidoId       String
  pedido         Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  skuId          String?
  sku            Sku?    @relation(fields: [skuId], references: [id])
  cantidad       Decimal @db.Decimal(12, 3)
  precioUnitario Decimal @db.Decimal(14, 2)
  subtotal       Decimal @db.Decimal(14, 2)
}

model Gasto {
  id          String           @id @default(cuid())
  categoria   CategoriaGasto
  descripcion String
  monto       Decimal          @db.Decimal(14, 2)
  fecha       DateTime
  pedidoId    String?
  pedido      Pedido?          @relation(fields: [pedidoId], references: [id])
  periodoId   String?
  periodo     PeriodoContable? @relation(fields: [periodoId], references: [id])
  recurrente  Boolean          @default(false)
  createdById String?
  createdBy   User?            @relation("GastoCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())

  @@index([fecha])
  @@index([categoria])
}

model ComisionConfig {
  id           String       @id @default(cuid())
  tipo         TipoComision
  porcentaje   Decimal?     @db.Decimal(6, 4)
  montoFijo    Decimal?     @db.Decimal(14, 2)
  vigenteDesde DateTime
  vigenteHasta DateTime?

  @@index([tipo, vigenteDesde])
}

model Envio {
  id                   String      @id @default(cuid())
  pedidoId             String      @unique
  pedido               Pedido      @relation(fields: [pedidoId], references: [id])
  transportista        String?
  numeroSeguimiento    String?
  estado               EstadoEnvio @default(PENDIENTE)
  fechaDespacho        DateTime?
  fechaEntregaEstimada DateTime?
  fechaEntregaReal     DateTime?
  actualizadoPorId     String?
  actualizadoPor       User?       @relation("EnvioActualizadoPor", fields: [actualizadoPorId], references: [id])
  nota                 String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

model PeriodoContable {
  id           String        @id @default(cuid())
  anio         Int
  mes          Int
  estado       EstadoPeriodo @default(ABIERTO)
  cerradoEn    DateTime?
  cerradoPorId String?
  cerradoPor   User?         @relation("PeriodoCerradoPor", fields: [cerradoPorId], references: [id])
  gastos       Gasto[]

  @@unique([anio, mes])
}

// ---------- Integracion Tienda Nube ----------

model TiendaNubeConexion {
  id             String   @id @default(cuid())
  storeId        String   @unique
  accessTokenEnc String
  scope          String?
  conectadoEn    DateTime @default(now())
  activo         Boolean  @default(true)
}

model WebhookEvent {
  id         String   @id @default(cuid())
  evento     String
  storeId    String
  payload    Json
  recibidoEn DateTime @default(now())
  procesado  Boolean  @default(false)
  error      String?

  @@index([procesado])
}

// ---------- Plan de lanzamiento ----------

model PlanTareaProgreso {
  // El id es el de la tarea (fija en src/lib/plan.ts, o el cuid de una PlanTareaCustom).
  id            String   @id
  hecho         Boolean  @default(false)
  actualizadoEn DateTime @updatedAt
}

model PlanTareaCustom {
  id       String   @id @default(cuid())
  faseNum  String
  texto    String
  puntos   Int
  creadoEn DateTime @default(now())

  @@index([faseNum])
}

// ---------- Club Fundadores ----------
// Página pública (otro dominio) a la que llega el fundador por QR. El contenido se
// edita desde el backoffice y se sirve por endpoints públicos, sin tocar código y sin
// que cambie nunca la URL del QR.

enum ClubBloqueTipo {
  TEXTO
  VIDEO
  DESCUENTO
  ENCUESTA
  INVITACION
  IMAGEN
}

// Bloques editables de la sección "Contenido dinámico". Se pueden crear, ordenar,
// ocultar y borrar. Cambian por completo sin rediseñar la página.
model ClubBloque {
  id        String         @id @default(cuid())
  tipo      ClubBloqueTipo @default(TEXTO)
  titulo    String?
  cuerpo    String? // texto (puede ser largo)
  codigo    String? // código de descuento (se muestra en un chip con botón Copiar)
  ctaTexto  String? // texto del botón (opcional)
  ctaUrl    String? // link del botón (opcional)
  mediaUrl  String? // url de video (embed) o imagen, según el tipo
  orden     Int            @default(0)
  visible   Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([orden])
}

// Hitos del "Historial del Ticket" (✓ desbloqueado / 🔒 bloqueado). Hace que el
// acceso se sienta vivo.
model ClubHistorialItem {
  id           String   @id @default(cuid())
  titulo       String
  desbloqueado Boolean  @default(false)
  orden        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orden])
}

// Config de las partes fijas de la página (hero + footer). Fila única ("singleton").
model ClubConfig {
  id            String   @id @default("singleton")
  heroTitulo    String   @default("Bienvenido al Club Fundadores")
  heroSubtitulo String?
  heroVideoUrl  String? // embed de YouTube/Vimeo sin listar
  introTitulo   String   @default("Qué es este acceso")
  introTexto    String?
  novedadesTexto String?
  footerTexto   String   @default("Gracias por haber estado desde el principio. — Fran")
  updatedAt     DateTime @updatedAt
}

// Lista "Fundadores": mails de "Activar novedades". Separada del newsletter.
model Fundador {
  id        String   @id @default(cuid())
  email     String   @unique
  origen    String   @default("club")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Zona Sur: pedidos manuales (envío por radio en mapa, o retiro en un punto de
// encuentro) con pago por transferencia o efectivo. Separado del modelo
// Pedido (ese está enganchado a Tienda Nube y a la contabilidad).
// ---------------------------------------------------------------------------

enum ZonaSurMetodoEntrega {
  ENVIO_ZONA
  PUNTO_QUILMES
  PUNTO_BERNAL
}

enum ZonaSurMetodoPago {
  TRANSFERENCIA
  EFECTIVO
}

enum ZonaSurEstado {
  PENDIENTE
  CONFIRMADO
  ENTREGADO
  CANCELADO
}

// Config de una fila única ("singleton"), editable desde el panel: zona de
// envío (centro + radio en km), precio, datos de transferencia y el punto de
// encuentro vigente de cada lugar (texto libre, se actualiza semana a semana).
model ZonaSurConfig {
  id                String   @id @default("singleton")
  zonaNombre        String   @default("Zona Sur")
  zonaCentroLat     Float    @default(-34.7206)
  zonaCentroLng     Float    @default(-58.2681)
  zonaRadioKm       Float    @default(5)
  zonaPrecio        Decimal  @default(0) @db.Decimal(14, 2)
  cbuAlias          String?
  titularCuenta     String?
  puntoQuilmesTexto String? // ej: "Jueves 25/9, 18 a 20hs, Rivadavia y Alsina"
  puntoBernalTexto  String?
  updatedAt         DateTime @updatedAt
}

model ZonaSurPedido {
  id             String               @id @default(cuid())
  clienteNombre  String
  clienteEmail   String
  clienteTelefono String
  metodoEntrega  ZonaSurMetodoEntrega
  direccion      String? // solo si metodoEntrega = ENVIO_ZONA
  puntoElegido   String? // copia del texto del punto vigente al momento del pedido
  metodoPago     ZonaSurMetodoPago
  comprobanteUrl String? // solo si metodoPago = TRANSFERENCIA
  total          Decimal              @db.Decimal(14, 2)
  estado         ZonaSurEstado        @default(PENDIENTE)
  nota           String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  items ZonaSurPedidoItem[]

  @@index([createdAt])
  @@index([estado])
}

model ZonaSurPedidoItem {
  id        String        @id @default(cuid())
  pedidoId  String
  pedido    ZonaSurPedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  skuId     String?
  sku       Sku?          @relation(fields: [skuId], references: [id])
  nombre    String // copia del nombre por si el SKU cambia despues
  cantidad  Int
  precioUnitario Decimal  @db.Decimal(14, 2)
  subtotal  Decimal       @db.Decimal(14, 2)
}
