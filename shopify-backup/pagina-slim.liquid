  {%- comment -%} ========================= TICKET FUNDADOR ========================= {%- endcomment -%}
  <section id="gia-fundador" class="gia-fundador" data-gia-solo-lanzamiento>
    <div class="gia-puente" data-gia-puente="arriba" data-desde="bg" style="top:0;height:110px"></div>
    <div class="gia-puente" data-gia-puente="abajo" data-desde="bg2" style="bottom:0;height:95px"></div>
    <div class="gia-patron" data-gia-patron style="--gia-op:.17">
      <div style="background-image:url('{{ gia_patron_marron_url }}');background-size:460px auto;background-position:left top;-webkit-mask-image:linear-gradient(to bottom, #000 0px, rgba(0,0,0,.8) 95px, transparent 215px);mask-image:linear-gradient(to bottom, #000 0px, rgba(0,0,0,.8) 95px, transparent 215px)"></div>
    </div>
    <div class="gia-patron" data-gia-patron style="--gia-op:.13">
      <div style="background-image:url('{{ gia_patron_crema_url }}');background-size:460px auto;background-position:left top;-webkit-mask-image:linear-gradient(to bottom, transparent 0px, rgba(0,0,0,.22) 115px, #000 235px, #000 calc(100% - 190px), rgba(0,0,0,.35) calc(100% - 130px), transparent calc(100% - 80px));mask-image:linear-gradient(to bottom, transparent 0px, rgba(0,0,0,.22) 115px, #000 235px, #000 calc(100% - 190px), rgba(0,0,0,.35) calc(100% - 130px), transparent calc(100% - 80px))"></div>
    </div>
    <div class="gia-patron" data-gia-patron style="--gia-op:.17">
      <div style="background-image:url('{{ gia_patron_marron_url }}');background-size:460px auto;background-position:left top;-webkit-mask-image:linear-gradient(to top, transparent 0px, transparent 35px, rgba(0,0,0,.55) 65px, #000 100px, rgba(0,0,0,.5) 145px, transparent 185px);mask-image:linear-gradient(to top, transparent 0px, transparent 35px, rgba(0,0,0,.55) 65px, #000 100px, rgba(0,0,0,.5) 145px, transparent 185px)"></div>
    </div>

    <div class="gia-wrap gia-wrap--sm">
      <p class="gia-comprar__eyebrow gia-reveal" style="color:var(--gia-gold-bright)">Para los primeros</p>
      <h2 class="gia-reveal" style="transition-delay:.05s">No est&#225;s por comprar solo una pasta de man&#237;.</h2>
      <p class="gia-fundador__copy gia-fundador__copy--promesa gia-solo-movil gia-reveal" style="transition-delay:.1s">
        <span>Todos los que compren durante las primeras 24 horas</span>
        <span>van a convertirse en</span>
        <span><strong style="color:var(--gia-gold-bright);font-weight:700">Fundadores de Giapura.</strong></span>
      </p>
      <p class="gia-fundador__copy gia-solo-desktop gia-reveal" style="transition-delay:.1s">
        <span>Todos los que compren durante las primeras 24 horas</span>
        <span>van a convertirse en Fundadores de Giapura.</span>
      </p>
      <p class="gia-fundador__copy gia-reveal" style="transition-delay:.15s">
        <span>Y junto con su pedido van a recibir un <strong style="color:var(--gia-gold-bright);font-weight:600">Ticket de Fundador</strong>:</span>
        <span>una tarjeta &#250;nica que acredita que estuvieron desde el principio.</span>
      </p>
    </div>

    <div class="gia-wrap gia-reveal" style="margin-top:3.5rem" data-gia-contador="grande"></div>

    <div class="gia-fundador__ticket gia-reveal" style="transition-delay:.1s">
      <div class="gia-ticket-visual" data-gia-ticket role="img" aria-label="Ticket de Fundador Giapura">
        <div class="gia-ticket-bg" aria-hidden="true"></div>
        <div class="gia-ticket-grano" aria-hidden="true"></div>
        <svg class="gia-ticket-marco" viewBox="0 0 1200 600" preserveAspectRatio="none" aria-hidden="true">
          <rect x="26" y="26" width="1148" height="548" rx="16" fill="none" stroke="#4a1c05" stroke-width="3" stroke-opacity=".55"/>
          <circle cx="26" cy="26" r="5" fill="#4a1c05" fill-opacity=".55"/>
          <circle cx="1174" cy="26" r="5" fill="#4a1c05" fill-opacity=".55"/>
          <circle cx="26" cy="574" r="5" fill="#4a1c05" fill-opacity=".55"/>
          <circle cx="1174" cy="574" r="5" fill="#4a1c05" fill-opacity=".55"/>
        </svg>
        <div class="gia-ticket-contenido">
          <img class="gia-ticket-logo" src="{{ gia_img_logo_marron_url }}" alt="Giapura" width="1219" height="422" loading="lazy" decoding="async">
          <p class="gia-ticket-tag">Volv&#233; a lo simple y real.</p>
        </div>
      </div>
    </div>

    <div class="gia-wrap gia-wrap--sm gia-fundador__pregunta">
      <h3 class="gia-reveal">&#191;Qu&#233; significa ser <span class="gia-grad">fundador</span>?</h3>
      <p class="gia-fundador__linea1 gia-reveal" style="transition-delay:.08s">Significa haber confiado cuando todo esto reci&#233;n empezaba.</p>
      <p class="gia-fundador__linea2 gia-reveal" style="transition-delay:.14s">Y esa confianza va a tener recompensas.</p>

      <div class="gia-beneficios">
        <p class="gia-chip gia-reveal" style="transition-delay:.26s;animation-delay:0s"><span class="gia-punto" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 13l5 5L19 7" stroke="#fff8ea" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span>Descuentos exclusivos</span></p>
        <p class="gia-chip gia-reveal" style="transition-delay:.33s;animation-delay:.7s"><span class="gia-punto" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 13l5 5L19 7" stroke="#fff8ea" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span>Elecciones de la marca</span></p>
        <p class="gia-chip gia-reveal" style="transition-delay:.4s;animation-delay:1.4s"><span class="gia-punto" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 13l5 5L19 7" stroke="#fff8ea" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span>Contenido exclusivo</span></p>
        <p class="gia-chip gia-reveal" style="transition-delay:.47s;animation-delay:2.1s"><span class="gia-punto" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 13l5 5L19 7" stroke="#fff8ea" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span>Acceso anticipado a futuros eventos</span></p>
        <p class="gia-chip gia-reveal" style="transition-delay:.54s;animation-delay:2.8s"><span class="gia-punto" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 13l5 5L19 7" stroke="#fff8ea" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span>Y m&#225;s cosas que vamos a ir construyendo juntos</span></p>
      </div>
    </div>

    <div class="gia-wrap gia-wrap--sm gia-fundador__condicion">
      <h3 class="gia-reveal">Pero hay una condici&#243;n.</h3>
      <p class="gia-reveal" style="transition-delay:.08s">Los Tickets de Fundador<br class="gia-corte-movil"> solo existen durante<br class="gia-corte-movil"> las <strong style="color:var(--gia-paper);font-weight:600">primeras 24 horas</strong>.</p>
      <p class="gia-fundador__despues gia-reveal" style="transition-delay:.14s">Despu&#233;s</p>
      <p class="gia-fundador__nunca gia-reveal" style="transition-delay:.2s">No va a haber forma<br class="gia-corte-movil"> de conseguir uno.</p>

      <div class="gia-valor gia-reveal" style="transition-delay:.28s">
        <p class="gia-valor__label">Valor del Ticket de Fundador</p>
        <p class="gia-valor__cifra">
          <span class="gia-valor__tachado">${{ gia_ticket_valor }}</span>
          <span class="gia-valor__flecha" aria-hidden="true">&#8594;</span>
          <span class="gia-valor__gratis">Gratis</span>
        </p>
        <p class="gia-valor__nota">Se entrega junto a tu pedido, sin costo.</p>
        <p class="gia-valor__cierre">Ma&#241;ana no existe.</p>
      </div>

      <div class="gia-fundador__final gia-reveal" style="transition-delay:.36s">
        <a class="gia-boton gia-boton--solid" href="{{ gia_cta_url }}" data-gia-cta>
          <span class="gia-boton__brillo" aria-hidden="true"></span>
          <span class="gia-boton__txt">Quiero ser fundador</span>
          <span class="gia-boton__flecha" aria-hidden="true">&#8594;</span>
        </a>
        <p class="gia-preventa-nota" style="color:rgba(245,238,223,.7)">Es una preventa: el pedido puede<br>demorar hasta 45 d&#237;as h&#225;biles.</p>
      </div>
    </div>
  </section>

  {%- comment -%} =========================== TESTIMONIOS =========================== {%- endcomment -%}
