{%- assign gia_js_url = 'https://cdn.shopify.com/s/files/1/0995/7068/0129/files/pagina_c6af7c09-0a8f-487e-9907-ce986d09a662.js?v=1788045337' -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&display=swap">

<link rel="stylesheet" href="{{ gia_css_url }}">

<div id="gia-pagina" data-contador-url="{{ gia_contador_url }}">

  {%- comment -%} ============================= HERO ============================= {%- endcomment -%}
  <section class="gia-hero">
    <img class="gia-hero__foto" src="{{ gia_img_fondo_url }}" alt="Textura de la pasta de man&#237; Giapura" fetchpriority="high" decoding="async">
    <div class="gia-hero__velo"></div>

    <div class="gia-hero__barra">
      <div class="gia-hero__pastilla">
        <div class="gia-contador" data-gia-contador="pastilla"></div>
      </div>
    </div>

    <div class="gia-hero__centro">
      <img class="gia-hero__logo" src="{{ gia_img_logo_url }}" alt="Giapura" width="582" height="181" fetchpriority="high">
      <h1 class="gia-hero__titulo">{{ gia_titulo }}</h1>
      <div class="gia-hero__cta">
        <a class="gia-boton gia-boton--crema" href="{{ gia_cta_url }}" data-gia-cta>
          <span class="gia-boton__brillo" aria-hidden="true"></span>
          <span class="gia-boton__txt">{{ gia_cta_texto }}</span>
          <span class="gia-boton__flecha" aria-hidden="true">&#8594;</span>
        </a>
        <p class="gia-preventa-nota" style="color:var(--gia-paper);text-shadow:0 1px 3px rgba(36,13,8,.5)">Es una preventa: el pedido puede<br>demorar hasta 45 d&#237;as h&#225;biles.</p>
      </div>
    </div>

    <div class="gia-hero__fundido" aria-hidden="true"></div>
    <div class="gia-hero__dibujo" aria-hidden="true">
      <img src="{{ gia_img_dibujo_url }}" alt="" width="480" height="589" loading="lazy" decoding="async">
    </div>
  </section>

  {%- comment -%} ===================== CARACTERISTICAS ===================== {%- endcomment -%}
  <section id="gia-comprar" class="gia-comprar">
    <div class="gia-patron" data-gia-patron style="--gia-op:.17">
      <div style="background-image:url('{{ gia_patron_marron_url }}');background-size:460px auto;background-position:left bottom;-webkit-mask-image:linear-gradient(to bottom, transparent 0%, rgba(0,0,0,.45) 34%, #000 78%, #000 100%);mask-image:linear-gradient(to bottom, transparent 0%, rgba(0,0,0,.45) 34%, #000 78%, #000 100%)"></div>
    </div>
    <div class="gia-wrap gia-wrap--lg gia-comprar__grid">
      <div class="gia-comprar__frasco gia-reveal">
        <img
          src="{{ gia_img_frasco_url }}&width=600"
          srcset="{{ gia_img_frasco_url }}&width=400 400w, {{ gia_img_frasco_url }}&width=600 600w, {{ gia_img_frasco_url }}&width=900 900w"
          sizes="(max-width: 1023px) 100vw, 29rem"
          alt="Los dos frascos de pasta de man&#237; Giapura, natural y con cacao, frente a una bandera argentina"
          width="1000" height="1250" loading="lazy" decoding="async">
      </div>
      <div class="gia-comprar__texto">
        <p class="gia-comprar__eyebrow gia-reveal" style="transition-delay:.1s">Natural &middot; Con cacao</p>
        <h2 class="gia-comprar__h2 gia-reveal" style="transition-delay:.15s">Volv&#233; a lo <span class="gia-grad">simple y real</span>.</h2>
