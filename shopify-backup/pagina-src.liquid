          <rect x="26" y="26" width="1148" height="548" rx="16" fill="none" stroke="#4a1c05" stroke-width="3" stroke-opacity=".55"/>
          <circle cx="26" cy="26" r="5" fill="#4a1c05" fill-opacity=".55"/>
          <circle cx="1174" cy="26" r="5" fill="#4a1c05" fill-opacity=".55"/>
          <circle cx="26" cy="574" r="5" fill="#4a1c05" fill-opacity=".55"/>
          <circle cx="1174" cy="574" r="5" fill="#4a1c05" fill-opacity=".55"/>
