        <p class="gia-preventa-nota" style="color:rgba(245,238,223,.7);margin-left:auto;margin-right:auto">Es una preventa: el pedido puede<br>demorar hasta 45 días hábiles.</p>
      </div>
    </div>
  </section>

  {%- if gia_whatsapp_numero != '' -%}
  <a class="gia-whatsapp" href="https://wa.me/{{ gia_whatsapp_numero }}?text=Hola!%20Tengo%20una%20duda%20sobre%20Giapura." target="_blank" rel="noopener noreferrer" aria-label="Escribinos por WhatsApp">
    <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16.004 3C9.377 3 4 8.373 4 15c0 2.34.65 4.53 1.78 6.4L4 29l7.79-1.74A11.9 11.9 0 0 0 16.004 27C22.63 27 28 21.627 28 15S22.63 3 16.004 3Zm0 21.7c-1.98 0-3.83-.55-5.41-1.5l-.39-.23-4.62 1.03 1.06-4.5-.25-.4A9.63 9.63 0 0 1 5.3 15c0-5.9 4.8-10.7 10.7-10.7S26.7 9.1 26.7 15 21.9 24.7 16.004 24.7Zm5.87-8.02c-.32-.16-1.9-.94-2.2-1.05-.29-.11-.51-.16-.72.16-.21.32-.83 1.05-1.02 1.26-.19.21-.37.24-.69.08-.32-.16-1.34-.5-2.55-1.58-.94-.84-1.58-1.88-1.76-2.2-.19-.32-.02-.49.14-.65.14-.14.32-.37.48-.55.16-.19.21-.32.32-.53.11-.21.05-.4-.03-.56-.08-.16-.72-1.75-.99-2.39-.26-.63-.53-.55-.72-.55h-.61c-.21 0-.56.08-.85.4-.29.32-1.11 1.09-1.11 2.65 0 1.56 1.14 3.07 1.3 3.28.16.21 2.24 3.42 5.42 4.79.76.33 1.35.52 1.81.67.76.24 1.45.21 2 .13.61-.09 1.9-.78 2.17-1.53.27-.75.27-1.4.19-1.53-.08-.13-.29-.21-.61-.37Z"/></svg>
  </a>
  {%- endif -%}

</div>

<script>
(function () {
  var raiz = document.getElementById('gia-pagina');
  if (!raiz) return;

  /* ---------- Reveal: entra al scrollear ---------- */
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (en.isIntersecting) { en.target.classList.add('gia-in'); io.unobserve(en.target); }
      });
    }, { rootMargin: '-60px 0px' });
    raiz.querySelectorAll('.gia-reveal, .gia-patron').forEach(function (el) { io.observe(el); });
  } else {
    raiz.querySelectorAll('.gia-reveal, .gia-patron').forEach(function (el) { el.classList.add('gia-in'); });
  }

  /* ---------- Puente de color: curva smootherstep, sin animar ---------- */
  var COLOR = { bg: [236,225,204], bg2: [245,238,223], dark: [36,13,8] };
  function smootherstep(t) { return t*t*t*(t*(t*6-15)+10); }
  function paradas(rgb, pasos) {
    pasos = pasos || 12;
    var out = [];
    for (var i = 0; i <= pasos; i++) {
      var t = i / pasos, a = 1 - smootherstep(t);
      out.push('rgba(' + rgb[0] + ',' + rgb[1] + ',' + rgb[2] + ',' + a.toFixed(3) + ') ' + (t*100).toFixed(1) + '%');
    }
    return out.join(', ');
  }
  raiz.querySelectorAll('[data-gia-puente]').forEach(function (el) {
    var dir = el.getAttribute('data-gia-puente') === 'arriba' ? 'to bottom' : 'to top';
    var color = COLOR[el.getAttribute('data-desde')];
    el.style.background = 'linear-gradient(' + dir + ', ' + paradas(color) + ')';
  });

  /* ---------- Carrusel de testimonios: infinito de verdad. La tira tiene
     la secuencia repetida x3; arranca centrada en la copia del medio y,
     cuando el usuario se acerca a una punta (con flechas o deslizando),
     salta sin animacion a la posicion equivalente de la copia del medio,
     asi nunca se nota un "reinicio". ---------- */
  var pista = raiz.querySelector('[data-gia-pista]');
  if (pista) {
    var flIzq = raiz.querySelector('[data-gia-flecha="izq"]');
    var flDer = raiz.querySelector('[data-gia-flecha="der"]');
    var items = Array.prototype.slice.call(pista.children);
    var porSet = parseInt(pista.getAttribute('data-gia-pista-set-size'), 10) || items.length;
    var indice = porSet;

    function posDe(i) {
      var el = items[i];
      return el.offsetLeft - pista.offsetLeft - (pista.clientWidth - el.clientWidth) / 2;
    }
    function irA(i, comportamiento) {
      if (i < 0 || i >= items.length) return;
      pista.scrollTo({ left: posDe(i), behavior: comportamiento || 'smooth' });
    }

    // arranca centrado en la copia del medio, sin animacion
    irA(indice, 'instant');

    var frame = 0, quieto = 0;
    pista.addEventListener('scroll', function () {
      cancelAnimationFrame(frame);
      clearTimeout(quieto);
      frame = requestAnimationFrame(function () {
        var centro = pista.scrollLeft + pista.clientWidth / 2, mejor = 0, dist = Infinity;
        items.forEach(function (el, i) {
          var c = el.offsetLeft - pista.offsetLeft + el.clientWidth / 2;
          var d = Math.abs(c - centro);
          if (d < dist) { dist = d; mejor = i; }
        });
        indice = mejor;
      });
      // recentra recien cuando el scroll ya se asento, para no cortar
      // ni el "smooth" del click ni el gesto de deslizar con el dedo
      quieto = setTimeout(function () {
        if (indice < porSet || indice >= porSet * 2) {
          var equivalente = (indice % porSet) + porSet;
          indice = equivalente;
          irA(equivalente, 'instant');
        }
      }, 120);
    }, { passive: true });

    flIzq.addEventListener('click', function () { irA(indice - 1); });
    flDer.addEventListener('click', function () { irA(indice + 1); });
  }

  /* ---------- Ano del pie ---------- */
  var anio = raiz.querySelector('[data-gia-anio]');
  if (anio) anio.textContent = new Date().getFullYear();

  /* ---------- Contador en vivo (mismo endpoint que giapura.com.ar) ---------- */
  /* La URL no puede ir como texto liquid en este JS: al vivir en un
     archivo .js aparte, Shopify no lo procesa (Liquid solo corre dentro
     de archivos .liquid), asi que llega leyendo el atributo del HTML. */
  var CONTADOR_URL = raiz.getAttribute('data-contador-url');
  function pad(n) { return n < 10 ? '0' + n : '' + n; }

  function estadoDe(data) {
    if (!data || !data.finAt) return { estado: 'pendiente' };
    var inicioMs = data.inicioAt ? new Date(data.inicioAt).getTime() : null;
    var finMs = new Date(data.finAt).getTime();
    var now = Date.now();
    if (inicioMs !== null && now < inicioMs) {
      var s1 = Math.max(0, Math.floor((inicioMs - now) / 1000));
      return { estado: 'proximamente', dias: Math.floor(s1/86400), horas: Math.floor((s1%86400)/3600), min: Math.floor((s1%3600)/60), seg: s1%60, inicioAt: data.inicioAt };
    }
    if (now > finMs) return { estado: 'recurrente' };
    var ms = finMs - now;
    return { estado: 'activo', horas: Math.floor(ms/3600000), min: Math.floor((ms%3600000)/60000), seg: Math.floor((ms%60000)/1000) };
  }

  function cajasHtml(items) {
    return items.map(function (it, i) {
      return '<div class="gia-cont-grupo"><div class="gia-cont-caja"><span class="gia-cont-num">' + pad(it[0]) + '</span><span class="gia-cont-lbl">' + it[1] + '</span></div>' +
        (i < items.length - 1 ? '<span class="gia-cont-sep">:</span>' : '') + '</div>';
    }).join('');
  }

  function pintarMini(el, st) {
    if (st.estado === 'pendiente') { el.innerHTML = ''; return; }
    if (st.estado === 'proximamente') {
      el.innerHTML = '<b>' + (st.dias > 0 ? st.dias + 'd ' : '') + pad(st.horas) + ':' + pad(st.min) + ':' + pad(st.seg) + '</b>';
      return;
    }
    if (st.estado === 'activo') { el.innerHTML = '<b>' + pad(st.horas) + ':' + pad(st.min) + ':' + pad(st.seg) + '</b>'; return; }
    el.innerHTML = '';
  }

  function pintarPastilla(el, st) {
    if (st.estado === 'pendiente') { el.innerHTML = ''; return; }
    if (st.estado === 'proximamente' || st.estado === 'activo') {
      var items = st.estado === 'proximamente'
        ? (st.dias > 0 ? [[st.dias,'días'],[st.horas,'hs'],[st.min,'min']] : [[st.horas,'horas'],[st.min,'min'],[st.seg,'seg']])
        : [[st.horas,'horas'],[st.min,'min'],[st.seg,'seg']];
      var intro = st.estado === 'proximamente' ? 'Las puertas abren en' : 'Las puertas cierran en';
      el.innerHTML = '<span class="gia-cont-intro">' + intro + '</span><div class="gia-cont-cajas">' + cajasHtml(items) + '</div>';
      return;
    }
    el.innerHTML = '';
  }

  function pintarGrande(el, st) {
    if (st.estado === 'pendiente') { el.innerHTML = ''; return; }
    if (st.estado === 'recurrente') { el.innerHTML = ''; return; }
    var items = st.estado === 'proximamente'
      ? (st.dias > 0 ? [[st.dias,'días'],[st.horas,'hs'],[st.min,'min']] : [[st.horas,'horas'],[st.min,'min'],[st.seg,'seg']])
      : [[st.horas,'horas'],[st.min,'min'],[st.seg,'seg']];
    el.innerHTML = '<div class="gia-cont-cajas">' + cajasHtml(items) + '</div>';
  }

  function aplicarBotones(st) {
    if (st.estado !== 'proximamente') return;
    var fecha = st.inicioAt ? new Date(st.inicioAt).toLocaleDateString('es-AR', { day: 'numeric', month: 'long' }) : '';
    raiz.querySelectorAll('[data-gia-cta]').forEach(function (a) {
      a.setAttribute('disabled', 'disabled');
      a.removeAttribute('href');
      a.querySelector('.gia-boton__txt').textContent = 'Disponible el ' + fecha;
      var fl = a.querySelector('.gia-boton__flecha'); if (fl) fl.style.display = 'none';
    });
  }

  function ocultarFundadorSiRecurrente(st) {
    var sec = raiz.querySelector('[data-gia-solo-lanzamiento]');
    if (sec && st.estado === 'recurrente') sec.style.display = 'none';
    var link = raiz.querySelector('[data-gia-solo-lanzamiento-link]');
    if (link && st.estado === 'recurrente') link.style.display = 'none';
  }

  function pintarTodo(st) {
    raiz.querySelectorAll('[data-gia-contador="mini"]').forEach(function (el) { pintarMini(el, st); });
    raiz.querySelectorAll('[data-gia-contador="pastilla"]').forEach(function (el) { pintarPastilla(el, st); });
    raiz.querySelectorAll('[data-gia-contador="grande"]').forEach(function (el) { pintarGrande(el, st); });
    aplicarBotones(st);
    ocultarFundadorSiRecurrente(st);
  }

  var ultimoData = null;
  function tick() { if (ultimoData) pintarTodo(estadoDe(ultimoData)); }

  fetch(CONTADOR_URL).then(function (r) { return r.json(); }).then(function (data) {
    ultimoData = data;
    tick();
    setInterval(tick, 1000);
  }).catch(function () {
    /* Sin datos: se queda en "Muy pronto", igual que hoy. */
  });

  /* ---------- Fade del logo del ticket atado a su propia carga ---------- */
  var ticketImg = raiz.querySelector('.gia-ticket-logo');
  if (ticketImg) {
    ticketImg.style.opacity = '0';
    ticketImg.style.transition = 'opacity .7s ease-out';
    function mostrar() { ticketImg.style.opacity = '1'; }
    if (ticketImg.complete) mostrar(); else ticketImg.addEventListener('load', mostrar);
  }
})();
</script>
